{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python tools/gcal.py list:*)",
      "Bash(.venv/bin/python tools/gcal.py get:*)",
      "Bash(.venv/bin/python tools/gcal.py pending list:*)",
      "Bash(.venv/bin/python tools/fitness.py:*)",
      "Bash(curl -s localhost:8080/api/status:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(.venv/bin/python tools/workout.py pull:*)",
      "Bash(.venv/bin/python tools/workout.py show:*)",
      "Bash(.venv/bin/python tools/workout.py find:*)",
      "Bash(.venv/bin/python tools/gcal.py create:*)",
      "Bash(.venv/bin/python tools/gcal.py update:*)",
      "Bash(.venv/bin/python tools/gcal.py pending add:*)",
      "Bash(.venv/bin/python tools/gcal.py pending remove:*)",
      "Bash(.venv/bin/python tools/gcal.py --help)",
      "Bash(.venv/bin/python tools/gcal.py * --help)",
      "Bash(.venv/bin/python tools/workout.py push:*)",
      "Bash(bash deploy/refresh-screen.sh)"
